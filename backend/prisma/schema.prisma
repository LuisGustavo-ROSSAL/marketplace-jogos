generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id                  Int                  @id @default(autoincrement())
  nome                String
  email               String               @unique
  passwordHash        String               @default("$2b$10$21V92Zk9GwSDXAdgqRr/oul1AN7/roDDo.q/eqCW35OdH1wUQDg9O")
  avaliacoesFeitas    AvaliacaoComprador[] @relation("CompradorAvaliou")
  avaliacoesRecebidas AvaliacaoComprador[] @relation("VendedorAvaliado")
  vendas              Venda[]              @relation("VendedorVenda")
  compras             Venda[]              @relation("CompradorVenda")
}

model Colecao {
  id          Int     @id @default(autoincrement())
  nomeConsole String
  transacoes  Venda[]
}

model Venda {
  id Int @id @default(autoincrement())

  idColecao Int
  item      Colecao @relation(fields: [idColecao], references: [id])

  idVendedor Int
  vendedor   Usuario @relation("VendedorVenda", fields: [idVendedor], references: [id])

  idComprador Int?
  comprador   Usuario? @relation("CompradorVenda", fields: [idComprador], references: [id])

  avaliacoes AvaliacaoComprador[]
}

model AvaliacaoComprador {
  id Int @id @default(autoincrement())

  idVenda Int
  venda   Venda @relation(fields: [idVenda], references: [id])

  idUsuario Int
  comprador Usuario @relation("CompradorAvaliou", fields: [idUsuario], references: [id])

  idVendor Int
  vendedor Usuario @relation("VendedorAvaliado", fields: [idVendor], references: [id])
}
